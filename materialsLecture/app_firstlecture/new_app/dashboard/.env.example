# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is git-ignored — never put real credentials in THIS file.
#
# From Supabase -> Connect. Use the "Session pooler" values (IPv4) if the
# direct host does not connect. For the form app you can use the "Transaction
# pooler" host with PGPORT=6543.

PGHOST=db.your-ref.supabase.co
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR-PASSWORD
PGDATABASE=postgres
PGSSLMODE=require
